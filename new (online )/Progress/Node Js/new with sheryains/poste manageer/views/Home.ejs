<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900 text-white">

    <div class="p-10">
        <h1 class="mb-5">Hello,Welcome back  <%=user.name%></h1>
      <div>
        <form action="/createpost/<%=user._id%>" method="post">
            <textarea name="content" class="w-1/3 h-20 resize-none rounded-md bg-zinc-800 border border-zinc-700 text-[13px]  p-2" placeholder="What's in your mind " id=""></textarea>
            <button class="block bg-blue-600  px-2 text-sm text-black py-0.5 rounded-md">Create post</button>
        </form>
      </div>

      <div class="text-white pt-7 ">
        <h1>Postes</h1>
        <%user.post.forEach((post)=>{%>

            <div class="mt-3">
                <div class="bg-zinc-800 pt-1 border px-2 border-zinc-700 w-1/3 h-25 rounded-md">
                    <h1 class="text-blue-500 text-[13px]">@<%=user.username%></h1>
                    <h1 class="text-[12px] overflow-scroll-auto tracking-tighter "><%=post.content%></h1>
                    <div class="text-[12px] w-full justify-end flex  items-end gap-3 pt-7">
                        <a href="/edit/<%=post._id%>" class="text-blue-600 ">Edit</a>
                        <a href="/delete/<%=post._id%>" class="text-red-500 ">Delete</a>
                        <!-- <a href="">Edit</a> -->
                    </div>
                </div>
            </div>
            <%})%>
      </div>
       
    </div>

   
</body>
</html>