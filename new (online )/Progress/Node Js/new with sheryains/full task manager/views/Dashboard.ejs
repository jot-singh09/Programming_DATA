<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskFlow</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="bg-[#07080E]  h-screen w-full transition-all duration-1000 relative ease-in-out ">
        <div class="flex justify-between py-1 px-4 max-lg:px-1 items-center">
            <div>
                <img src="/images/logo.png" class="w-50 max-lg:w-35" alt="logo">
            </div>

            <!-- right side of navbar -->
            <div class="text-white pr-14 max-lg:pr-2 overflow-hidden " id="Opendropdown">
                <div class="flex gap-2 items-center justify-between ">
                    <div class="pr-0.5 max-lg:pr-1` max-lg:pt-1">
                        <h1 class="bg-[#232732] rounded-full px-4 py-2 text-lg font-black">
                            <%=letter[0]%>
                        </h1>
                    </div>
                    <div class="text-white font-medium text-xl max-md:hidden">
                        <%= Username %>
                    </div>

                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                        class="max-md:hidden">
                        <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" />
                    </svg>
                </div>


                <!-- Drop down  -->
                <div class="absolute overflow-hidden h-0  transition-all duration-1000 ease-in-out bg-[#0C0E15] absolute px-8  mt-5 rounded-lg  border-gray-800 right-14 max-lg:right-5 max-lg:mt-3 flex flex-col gap-2"
                    id="showdrop">
                    <div class="flex gap-2 transition-all duration-500 ease-in-out hover:text-white  text-gray-500">
                        <svg class="w-5 h-5 " viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8" />
                            <path d="M5 20C5 16.7 7.7 14.5 12 14.5C16.3 14.5 19 16.7 19 20" stroke="currentColor"
                                stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <h1>Profile</h1>
                    </div>
                    <div class="flex gap-2 transition-all duration-500 ease-in-out text-gray-500  hover:text-white">
                        <svg class="w-5 h-5 " viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M9.7 3.6L10.2 2.5H13.8L14.3 3.6L16 4.3L17.1 3.8L19.7 6.4L19.2 7.5L19.9 9.2L21 9.7V13.3L19.9 13.8L19.2 15.5L19.7 16.6L17.1 19.2L16 18.7L14.3 19.4L13.8 20.5H10.2L9.7 19.4L8 18.7L6.9 19.2L4.3 16.6L4.8 15.5L4.1 13.8L3 13.3V9.7L4.1 9.2L4.8 7.5L4.3 6.4L6.9 3.8L8 4.3L9.7 3.6Z"
                                stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <circle cx="12" cy="11.5" r="2.5" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                        <h1>Setting</h1>

                    </div>
                    <div class="flex gap-2 transition-all duration-500 ease-in-out text-gray-500 hover:text-white">
                        <svg class="w-5 h-5 " viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
                            <path
                                d="M9.5 9.2C9.7 7.8 10.8 7 12.2 7C13.8 7 15 8 15 9.5C15 10.8 14.2 11.5 13.1 12.2C12.3 12.7 12 13.2 12 14"
                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            <circle cx="12" cy="17" r="1" fill="currentColor" />
                        </svg>

                        <h1>Help & Support</h1>
                    </div>

                    <div class="border-t border-gray-500 absolute bottom-9 w-full origin-left"></div>

                    <a href="/"
                        class="text-red-600 mt-2 flex gap-2 transition-all duration-500 ease-in-out  hover:text-red-700">
                        <svg class="w-5 h-5 " viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="6" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8" />

                            <path d="M8 6V4.5C8 3.67 8.67 3 9.5 3H14.5C15.33 3 16 3.67 16 4.5V6" stroke="currentColor"
                                stroke-width="1.8" stroke-linecap="round" />

                            <path d="M3 11H21" stroke="currentColor" stroke-width="1.8" />

                            <path d="M10 11V13H14V11" stroke="currentColor" stroke-width="1.8"
                                stroke-linejoin="round" />
                        </svg>
                        <h1>Log out</h1>
                    </a>

                </div>
            </div>
        </div>


        <!-- body -->
         <div class="px-5 py-5">
             <form action="/createtask" method="post">
             <div class=" flex gap-5 bg-[#0C0E15] px-7   pt-3 border  border-gray-800  rounded-lg">
                 
                 <div class=" w-full pb-5  text-white ">
                     <div class="flex gap-2 items-center">
                         <svg class="w-7 h-7 text-purple-500" viewBox="0 0 24 24" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 20H5C4.44772 20 4 19.5523 4 19V5C4 4.44772 4.44772 4 5 4H14" stroke="currentColor"
                    stroke-width="1.8" stroke-linecap="round" />
                    
                    <path
                    d="M16.5 3.5C17.3284 2.67157 18.6716 2.67157 19.5 3.5C20.3284 4.32843 20.3284 5.67157 19.5 6.5L11 15L7 16L8 12L16.5 3.5Z"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h1 class="text-2xl font-semibold">Create a Task</h1>
            </div>
            
            
            <div class="mt-5 flex flex-col">
                <div class="flex flex-col gap-1 ">
                    <h1 class="px-0.5 text-lg font-medium">Title</h1>
                    <input type="text" placeholder="e.g. Design landing page" name="Title"
                    class="w-125 h-12 px-4 bg-[#07080E] border border-gray-800 rounded-lg text-white" />
                </div>
                <div class="mt-5 flex gap-5">
                    <div class="flex flex-col gap-1 ">
                        <h1 class="px-0.5 text-lg font-medium">Priority</h1>
                        <select class=" h-10 px-4 rounded-lg outline-none w-60 bg-[#07080E] border border-[#202331] text-gray-200" name="select">
                            <option value="" disabled selected>Select priority</option>
                            <option value="low" class="bg-[#0D0F18] text-blue-500">
                                Low
                            </option>
                            <option value="medium" class="bg-[#0D0F18] text-yellow-400">
                                Medium
                            </option>
                            <option value="high" class="bg-[#0D0F18] text-red-400">
                                High
                            </option>
                        </select>
                    </div>
                    <div>
                        <h1 class="px-0.5 text-lg font-medium">Due Date</h1>
                        <input type="datetime" placeholder="12/12/2009" name="Date"
                        class="w-60 h-12 px-4 bg-[#07080E] border border-gray-800 rounded-lg text-white" />
                    </div>
                    
                    
                </div>
            </div>
        </div>
        
        <div class="  py-14">
            <div class="text-white flex flex-col gap-1  relative pb-13">
                <h1 class="px-2">Description <span class="text-gray-400">(optional)</span></h1>
              <textarea 
    name="Description" 
    id="" 
    class="text-white resize-none outline-none py-2 w-125 h-22 px-4 bg-[#07080E] border border-gray-800 rounded-lg" 
    value=""
>
</textarea> 
<div class="absolute right-0 bottom-0">
    <button class="bg-[#7525FE] px-12 hover:bg-[#6228FC] transition-all duration-1000 ease-in-out hover:scale-90 text-lg font-black rounded-lg py-2">Add</button>
</div>
            </div>
        </div>
    </div>
    </form>


    <% files.forEach((val)=>{ %>
        
        <div class="text-yellow-400 text-4xl flex flex-col gap-">
            <%val.replace('.txt', '')%>
            <%=val%>
            
            <%})%>
        </div>
            
</div>
    
    <script>
        let dropdown = document.querySelector('#Opendropdown')
            let showdrop = document.querySelector('#showdrop')
            dropdown.addEventListener('mouseover', () => {

                showdrop.classList.add('h-35');
                showdrop.classList.add('py-2');
                showdrop.classList.remove('h-0');
                showdrop.classList.add('border');
            });

            dropdown.addEventListener('mouseout', () => {
                console.log('Hovered out');
                showdrop.classList.remove('py-2');
                showdrop.classList.remove('border');
                showdrop.classList.remove('h-35');
                showdrop.classList.add('h-0');
            });


            let active = false
            dropdown.addEventListener('click', () => {
                if (active == false) {
                    showdrop.classList.add('h-35');
                    showdrop.classList.add('py-2');
                    showdrop.classList.remove('h-0');
                    showdrop.classList.add('border');
                    active = true
                }
                else if (active == true) {
                    showdrop.classList.remove('py-2');
                    showdrop.classList.remove('border');
                    showdrop.classList.remove('h-35');
                    showdrop.classList.add('h-0');
                    active = false
                }


            });


        </script>
</body>

</html>