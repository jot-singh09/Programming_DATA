<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskFlow</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-[#07080E] h-screen w-full transition-all duration-1000 ease-in-out flex flex-col items-center ">
        
        <!-- Error Message Display -->
        <% if (message) { %>
            <h1 id="errorMessage" class="text-xl bg-red-900 transition-all duration-1000 ease-in-out text-white absolute right-3 top-5 px-3 py-2 rounded-lg">
                <%= message %>
            </h1>
        <% } %>
       
        <div class="py-15 font-black ">
            <h1 class="text-white text-4xl  max-lg:text-3xl">Welcome To TaskFlow</h1>
        </div>
        
        <div class="">
            <form action="/register" method="post" class="text-white border rounded-2xl max-lg:px-3 max-lg:py-5 px-10 py-10 border-gray-600 flex flex-col gap-5">
                <div class="flex flex-col gap-2 relative justify-center">
                    <h1 class="text-xl font-semibold px-2">Username</h1>
                    <div>
                        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute bottom-0">
                            <rect width="44" height="44" rx="4" fill=""/>
                            <rect x="13.5" y="15.5" width="17" height="13" rx="1.5" stroke="#B8BCC8" stroke-width="1.2"/>
                            <path d="M14.5 17L22 22.5L29.5 17" stroke="#B8BCC8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <input type="text" placeholder="Set the Username" class="bg-[#13151C] border border-gray-800 px-12 py-2.5 rounded-md outline-none" name="username" required>
                    </div>
                </div>
                
                <div class="flex flex-col gap-2 relative justify-center">
                    <h1 class="text-xl font-semibold px-2">Password</h1>
                    <div>
                        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute bottom-0">
                            <rect width="44" height="44" rx="4" fill=""/>
                            <rect x="14" y="20" width="16" height="11" rx="1.5" stroke="#B8BCC8" stroke-width="1.2"/>
                            <path d="M17.5 20V16.5C17.5 14.01 19.51 12 22 12C24.49 12 26.5 14.01 26.5 16.5V20" stroke="#B8BCC8" stroke-width="1.2" stroke-linecap="round"/>
                            <circle cx="22" cy="25" r="1.2" fill="#B8BCC8"/>
                            <path d="M22 26.2V28" stroke="#B8BCC8" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                        <input type="password" placeholder="Set the Password" class="bg-[#13151C] border border-gray-800 px-12 py-2.5 rounded-md outline-none" name="pass" required>
                    </div>
                </div>
                
                <div class="flex justify-between">
                    <h1><input type="checkbox" required> Accept our Policy</h1>
                </div>
                
                <div class="">
                    <button class="bg-[#7C49D6] w-full px-2 py-3 font-bold text-xl flex items-center justify-center rounded-lg hover:scale-98 active:scale-110 duration-300 ease-in-out">
                        Register
                    </button>
                </div>

                <div class="flex justify-between">
                    <h1 class="text-gray-500">Already Account..</h1>
                    <a href="/" class="text-[#7C49D6]">Login now</a>
                </div>
            </form>
        </div>

        <div class="animate-bounce  bg-[#13151C] mt-10 px-4 py-2 rounded-lg text-white font-black border border-gray-500 max-lg:hidden">
                <h1> <span class=" ">Note :</span> The Passward Can't be Forgeted so Keep it Remindered</h1>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-hide error message after 5 seconds
            const errorMsg = document.getElementById('errorMessage');
            if (errorMsg) {
                setTimeout(() => {
                    errorMsg.style.transition = 'all 0.5s ease-in-out';
                    errorMsg.style.opacity = '0';
                    errorMsg.style.transform = 'translateY(-20px)';
                    setTimeout(() => errorMsg.style.display = 'none', 500);
                }, 5000);
            }
            
            // Auto-hide success message after 5 seconds
            const successMsg = document.getElementById('successMessage');
            if (successMsg) {
                setTimeout(() => {
                    successMsg.style.transition = 'all 0.5s ease-in-out';
                    successMsg.style.opacity = '0';
                    successMsg.style.transform = 'translateY(-20px)';
                    setTimeout(() => successMsg.style.display = 'none', 500);
                }, 5000);
            }
        });
    </script>
</body>
</html>