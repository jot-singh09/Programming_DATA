<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Read user</title>
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>   
</head>
<body class="bg-black text-white">
    
    <div class=" pt-7 px-5 flex flex-col gap-2">
        <a class="text-xl text-blue-800 relative after:absolute after:w-0 hover:after:w-33 after:h-0.5 after:bottom-0 after:left-0 after:bg-blue-800 after:transition-all after:duration-300 after:ease-in-out" href="/">Back to home</a>
        <div class="pt-7 px-2">
           <h1 class="text-3xl font-bold ">All Users</h1>



           <div class="flex  gap-2 pt-5 flex-wrap">
            <% user.forEach((user)=>{ %>

                <div class="flex flex-col gap-2 border-2 border-zinc-900 p-1 w-61 ">
                    <div class="w-full h-58 bg-black overflow-hidden">
                    <img src="<%=user.image%>" class="object-cover " alt="">    
                    </div>
                    <div class="flex-col px-1 pt-1 flex gap-1">
                        <h1 class="text-xl font-bold"><%=user.name%></h1>
                        <h1 class="lowercase text-[13px] text-gray-500"><%=user.email%></h1>
                    </div>
                    <div class="pt-2 px-2 pb-3 flex gap-4">
                        <a href="/edit/<%= user._id %>" class="text-yellow-600/90">Edit User</a>
                        <a href="/delete/<%= user._id %>" class="text-red-700/90">Delete User</a>
                    </div>
                    
                </div>
                <%})%>

           </div>
        </div>
    </div>

</body>
</html>